{
	"tasks": {
		"build": "deno run --allow-env --allow-read --allow-write=output npm:tiddlywiki@5.4.1 --build",
		"build:default-app": "deno run -A scripts/build_default_app.ts",
		"build:all": "deno task build && deno task build:default-app",
		"test": "deno test -A server/",
		"fmt": "deno fmt --ignore='**/*.css' plugins server"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 120,
		"singleQuote": true,
		"proseWrap": "preserve"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.0",
		"@std/cli/parse-args": "jsr:@std/cli@^1.0.0/parse-args",
		"@std/dotenv": "jsr:@std/dotenv@^0.225.0",
		"@std/encoding/base64": "jsr:@std/encoding@^1.0.0/base64",
		"@std/encoding/base64url": "jsr:@std/encoding@^1.0.0/base64url",
		"argon2ian": "https://deno.land/x/argon2ian@2.0.0/src/argon2.ts",
		"brotli": "https://deno.land/x/brotli@0.1.7/mod.ts",
		"cliffy/prompt/secret": "https://deno.land/x/cliffy@v0.25.7/prompt/secret.ts",
		"sqlite": "https://deno.land/x/sqlite@v3.9.0/mod.ts"
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any"]
		}
	}
}
