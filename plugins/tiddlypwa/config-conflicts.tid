title: $:/plugins/mblackman/tiddlypwa/config-conflicts
tags: $:/tags/ControlPanel/TiddlyPWA
caption: Conflicts

\define tv-wikilinks() no

<h3>Conflicted Tiddlers</h3>

<$list filter="[tag[$:/tags/TiddlyPWA/Conflict]]" emptyMessage="<p>No unresolved conflicts found.</p>">
<div class="tiddlypwa-conflict-card">
  <div>
    <strong><$link to=<<currentTiddler>>><<currentTiddler>></$link></strong>
  </div>
  <div class="tiddlypwa-conflict-meta">
    Original: <$link to={{!!tiddlypwa-conflict-of}}><$text text={{!!tiddlypwa-conflict-of}}/></$link> &bull;
    Branch: <code><$text text={{!!tiddlypwa-conflict-source}}/></code> &bull;
    Date: <$text text={{!!tiddlypwa-conflict-date}}/>
  </div>
  <$list filter="[<currentTiddler>has[_canonical_uri]]" variable="isBinary">
    <div class="tiddlypwa-conflict-preview">
      <em>Binary attachment conflict copy (preview):</em>
      <$transclude $tiddler=<<currentTiddler>> $mode="block"/>
    </div>
  </$list>
  <$list filter="[<currentTiddler>!has[_canonical_uri]]" variable="isText">
    <div class="tiddlypwa-conflict-diff">
      <$diff-text source={{{ [{!!tiddlypwa-conflict-of}get[text]] }}} dest={{!!text}}>
        <div class="tiddlypwa-text-muted">Diff against current canonical tiddler (<code>&lt;$diff-count&gt;</code>): <$text text=<<diff-count>>/> change(s)</div>
      </$diff-text>
    </div>
  </$list>
  <div class="tiddlypwa-conflict-actions">
    <$button class="tc-btn-small">
      <$action-sendmessage $message="tiddlypwa-resolve-conflict" conflictTitle=<<currentTiddler>> action="keep-conflict"/>
      Keep This Version
    </$button>
    <$button class="tc-btn-small">
      <$action-sendmessage $message="tiddlypwa-resolve-conflict" conflictTitle=<<currentTiddler>> action="discard-conflict"/>
      Discard Conflict Copy
    </$button>
  </div>
</div>
</$list>
