title: $:/plugins/valpackett/tiddlypwa/config-conflicts
tags: $:/tags/ControlPanel/TiddlyPWA
caption: Conflicts

\define tv-wikilinks() no

<h3>Conflicted Tiddlers</h3>

<$list filter="[tag[$:/tags/TiddlyPWA/Conflict]]" emptyMessage="<p>No unresolved conflicts found.</p>">
<div style="border: 1px solid #ddd; padding: 10px; margin-bottom: 10px; border-radius: 4px; background: #fafafa;">
  <div>
    <strong><$link to=<<currentTiddler>>><<currentTiddler>></$link></strong>
  </div>
  <div style="margin: 4px 0; font-size: 0.9em; color: #666;">
    Original: <$link to={{!!tiddlypwa-conflict-of}}><$text text={{!!tiddlypwa-conflict-of}}/></$link> &bull;
    Branch: <code><$text text={{!!tiddlypwa-conflict-source}}/></code> &bull;
    Date: <$text text={{!!tiddlypwa-conflict-date}}/>
  </div>
  <div style="margin: 6px 0; padding: 6px; background: #fff; border: 1px solid #eee; max-height: 150px; overflow-y: auto; font-family: monospace; font-size: 0.85em; white-space: pre-wrap;">
    <$text text={{!!text}}/>
  </div>
  <div style="margin-top: 8px;">
    <$button class="tc-btn-small">
      <$action-setfield $tiddler={{!!tiddlypwa-conflict-of}} text={{!!text}} tags={{!!tags}}/>
      <$action-deletefield $tiddler={{!!tiddlypwa-conflict-of}} tiddlypwa-conflict-of tiddlypwa-conflict-source tiddlypwa-conflict-date/>
      <$action-listops $tiddler={{!!tiddlypwa-conflict-of}} $subfilter="-[[$:/tags/TiddlyPWA/Conflict]]"/>
      <$action-deletetiddler $tiddler={{{ [{!!tiddlypwa-conflict-of}addprefix[Draft of ']]addsuffix['] }}}/>
      <$action-deletetiddler $tiddler=<<currentTiddler>>/>
      <$action-setfield $tiddler="$:/status/TiddlyPWAConflictsCount" text={{{ [tag[$:/tags/TiddlyPWA/Conflict]!title<currentTiddler>count[]] }}}/>
      Keep This Version
    </$button>
    <$button class="tc-btn-small">
      <$action-deletetiddler $tiddler=<<currentTiddler>>/>
      <$action-setfield $tiddler="$:/status/TiddlyPWAConflictsCount" text={{{ [tag[$:/tags/TiddlyPWA/Conflict]!title<currentTiddler>count[]] }}}/>
      Discard Conflict Copy
    </$button>
  </div>
</div>
</$list>
