title: $:/plugins/mblackman/tiddlypwa/banner-conflict
tags: $:/tags/PageTemplate

<$list filter="[tag[$:/tags/TiddlyPWA/Conflict]limit[1]]" variable="hasConflicts">
<$reveal type="nomatch" state="$:/temp/HideConflictBanner" text="yes">
<div class="tc-plugin-reload-warning tiddlypwa-banner-warning" role="alert">
  <div>
    <strong>⚠️ Sync conflict detected:</strong> one or more conflict copies were preserved.
    <$button message="tiddlypwa-open-conflicts" class="tc-btn-small">
      Review Conflicts
    </$button>
  </div>
  <$button set="$:/temp/HideConflictBanner" setTo="yes" class="tc-btn-invisible tiddlypwa-banner-dismiss" tooltip="Dismiss notification" aria-label="Dismiss conflict banner">{{$:/core/images/close-button}}</$button>
</div>
</$reveal>
</$list>
