title: $:/plugins/mblackman/tiddlypwa/banner-conflict
tags: $:/tags/PageTemplate

<$list filter="[tag[$:/tags/TiddlyPWA/Conflict]limit[1]]" variable="hasConflicts">
<$reveal type="nomatch" state="$:/temp/HideConflictBanner" text="yes">
<div class="tc-plugin-reload-warning" role="alert" style="z-index: 5000; background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; padding: 10px 14px; margin: 5px 0; display: flex; align-items: center; justify-content: space-between; gap: 10px;">
  <div>
    <strong>⚠️ Sync conflict detected:</strong> one or more conflict copies were preserved.
    <$button to="$:/ControlPanel" class="tc-btn-small" style="margin-left: 10px; font-weight: bold;">
      <$action-setfield $tiddler="$:/state/tab-1749438307" text="$:/plugins/mblackman/tiddlypwa/config"/>
      <$action-setfield $tiddler="$:/state/tab--84302341" text="$:/plugins/mblackman/tiddlypwa/config-conflicts"/>
      Review Conflicts
    </$button>
  </div>
  <$button set="$:/temp/HideConflictBanner" setTo="yes" class="tc-btn-invisible" tooltip="Dismiss notification" style="cursor: pointer; opacity: 0.7; padding: 2px 6px;">{{$:/core/images/close-button}}</$button>
</div>
</$reveal>
</$list>
